# Copy to .env for local development. Production values are set on Render.
PORT=4000
# Empty = in-memory PGlite; "pglite:./.data" = local PGlite folder; postgres://... = Neon
DATABASE_URL=pglite:./.data
API_URL=http://localhost:4000
WEB_URL=http://localhost:3100
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Optional: GitHub OAuth app (callback http://localhost:4000/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Google OAuth client (callback http://localhost:4000/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_ENABLED=true
